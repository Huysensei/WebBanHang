@model List<CosmeticsShop.Models.User>
@{
    ViewBag.Title = "Quản lý khách hàng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-primary">
                   <i class="fas fa-users mr-2"></i>Quản lý khách hàng
                </h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/Admin/Dashboard">Trang chủ</a></li>
                    <li class="breadcrumb-item active">Quản lý khách hàng</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card card-primary card-outline">
                    <div class="card-header">
                        @if (string.IsNullOrEmpty(Request.Params["keyword"]))
                        {
                            <h3 class="card-title"><i class="fas fa-list mr-1"></i>Danh sách khách hàng</h3>
                        }
                        else
                        {
                            <h3 class="card-title"><i class="fas fa-search mr-1"></i>Kết quả tìm kiếm: "@Request.Params["keyword"]"</h3>
                        }
                        <div class="card-tools">
                            <form action="/KhachHangManage/" method="get">
                                <div class="input-group input-group-sm" style="width: 250px;">
                                    <input type="text" name="keyword" class="form-control" placeholder="Tìm kiếm tên, email..." required>
                                    <div class="input-group-append">
                                        <button type="submit" class="btn btn-primary">
                                            <i class="fas fa-search"></i>
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                    <div class="card-body table-responsive p-0">
                        <table class="table table-hover table-striped">
                            <thead>
                                <tr class="bg-light">
                                    <th style="width: 60px" class="text-center">ID</th>
                                    <th>Tên khách hàng</th>
                                    <th>Email</th>
                                    <th style="width: 150px" class="text-center">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Count > 0)
                                {
                                    foreach (var item in Model)
                                    {
                                        <tr>
                                            <td class="text-center">@item.ID</td>
                                            <td><strong>@item.Name</strong></td>
                                            <td><a href="mailto:@item.Email">@item.Email</a></td>
                                            <td class="text-center">
                                                <form action="@Url.Action("Delete", "KhachHangManage")" method="post" style="display:inline;">
                                                    <input type="hidden" name="id" value="@item.ID" />
                                                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Bạn có chắc chắn muốn xóa khách hàng này?')">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-4">
                                            <div class="alert alert-info mb-0">
                                                <i class="fas fa-info-circle mr-1"></i> Không tìm thấy khách hàng nào!
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="card-footer clearfix">
                        <div class="row">
                            <div class="col-sm-6">
                                <small class="text-muted">Hiển thị @(Model != null ? Model.Count : 0) khách hàng</small>
                            </div>
                           
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>