@model List<CosmeticsShop.Models.OrderDetail>
@{
    ViewBag.Title = "Chi tiết đơn hàng: " + Request.Params["ID"];
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    decimal total = 0;
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Chi tiết đơn đặt hàng: #@Request.Params["ID"]</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/Admin/Dashboard">Trang chủ</a></li>
                    <li class="breadcrumb-item"><a href="/OrderManage">Quản lý đơn hàng</a></li>
                    <li class="breadcrumb-item active">Chi tiết đơn hàng</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Thông tin đơn hàng</h3>
                        <div class="card-tools">
                            @if (ViewBag.Order != null)
                            {
                                <span class="badge @(ViewBag.IsProcessed ? "badge-success" : "badge-warning")">
                                    @(ViewBag.IsProcessed ? "Đã xử lý" : "Chờ xử lý")
                                </span>
                            }
                        </div>
                    </div>
                    <div class="card-body table-responsive p-0">
                        <table class="table table-hover text-nowrap">
                            <thead>
                                <tr>
                                    <th>Mã SP</th>
                                    <th>Tên sản phẩm</th>
                                    <th>Hình ảnh</th>
                                    <th>Đơn giá</th>
                                    <th>Số lượng</th>
                                    <th>Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    if (Model != null && Model.Count > 0)
                                    {
                                        foreach (var item in Model)
                                        {
                                            total += (item.ProductPrice ?? 0) * (item.Quantity ?? 0);
                                            <tr>
                                                <td>@(item.ProductID)</td>
                                                <td>@(item.ProductName)</td>
                                                <td>
                                                    <img src="~/Content/images/SanPham/@(item.ProductImage)" alt="@(item.ProductName)"
                                                         style="width:50px;height:80px" class="img-thumbnail" />
                                                </td>
                                                <td>@(String.Format("{0:N0}", item.ProductPrice)) đ</td>
                                                <td>@(item.Quantity)</td>
                                                <td>@(String.Format("{0:N0}", item.ProductPrice * item.Quantity)) đ</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center">
                                                <i class="fas fa-exclamation-circle text-warning"></i> Không có sản phẩm nào...
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="5" class="text-right"><strong>Tổng tiền:</strong></td>
                                    <td><strong>@(String.Format("{0:N0}", total)) đ</strong></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <div class="card-footer">
                        <div class="float-right">
                            <a href="/OrderManage" class="btn btn-default mr-2">
                                <i class="fas fa-arrow-left"></i> Quay lại
                            </a>
                            @if (!ViewBag.IsProcessed)
                            {
                                <a href="/OrderManage/Processed/@Request.Params["ID"]" class="btn btn-primary">
                                    <i class="fas fa-check"></i> Duyệt đơn
                                </a>
                                <a href="/OrderManage/Delete/@Request.Params["ID"]" class="btn btn-danger ml-2"
                                   onclick="return confirm('Bạn có chắc chắn muốn xoá đơn hàng này không?');">
                                    <i class="fas fa-trash"></i> Xoá đơn
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
