@model List<CosmeticsShop.Models.Category>
@{
    ViewBag.Title = "Quản lý danh mục";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-3">
            <div class="col-sm-6">
                <h1 class="m-0 text-primary">
                    <i class="fas fa-list-alt mr-2"></i>Quản lý danh mục
                </h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/Admin">Trang chủ</a></li>
                    <li class="breadcrumb-item active">Danh mục</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card card-primary card-outline shadow-sm">
                    <div class="card-header">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                @if (string.IsNullOrEmpty(Request.Params["keyword"]))
                                {
                                    <h3 class="card-title font-weight-bold">
                                        <i class="fas fa-tag mr-1"></i>Danh sách danh mục
                                    </h3>
                                }
                                else
                                {
                                    <h3 class="card-title font-weight-bold">
                                        <i class="fas fa-search mr-1"></i>Kết quả tìm kiếm: "<span class="text-info">@Request.Params["keyword"]</span>"
                                    </h3>
                                }
                            </div>
                            <div class="card-tools">
                                <form action="/CategoryManage/" method="get" class="input-group input-group-sm" style="width: 250px;">
                                    <input type="text" name="keyword" class="form-control" placeholder="Nhập từ khóa tìm kiếm..." value="@Request.Params["keyword"]">
                                    <div class="input-group-append">
                                        <button type="submit" class="btn btn-primary">
                                            <i class="fas fa-search"></i>
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                    <div class="card-body">
                        <div class="mb-3">
                            <a href="/CategoryManage/Add" class="btn btn-success">
                                <i class="fas fa-plus-circle mr-1"></i>Thêm danh mục mới
                            </a>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-bordered table-hover">
                                <thead class="thead-light">
                                    <tr>
                                        <th width="80" class="text-center">ID</th>
                                        <th>Tên danh mục</th>
                                        <th width="120" class="text-center">Trạng thái</th>
                                        <th width="220" class="text-center">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model != null && Model.Count > 0)
                                    {
                                        foreach (var item in Model)
                                        {
                                            <tr>
                                                <td class="text-center">@item.ID</td>
                                                <td class="font-weight-bold">@item.Name</td>
                                                <td class="text-center">
                                                    @if (item.IsActive.Value)
                                                    {
                                                        <span class="badge badge-success px-3 py-2"><i class="fas fa-check-circle mr-1"></i>Kích hoạt</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge badge-danger px-3 py-2"><i class="fas fa-ban mr-1"></i>Đã khóa</span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    <div class="btn-group">
                                                        <a href="/CategoryManage/Details/@item.ID" class="btn btn-info btn-sm">
                                                            <i class="fas fa-edit mr-1"></i>Chi tiết/Sửa
                                                        </a>
                                                        @if (item.IsActive.Value)
                                                        {
                                                            <a href="/CategoryManage/ToggleActive/@item.ID" class="btn btn-danger btn-sm">
                                                                <i class="fas fa-lock mr-1"></i>Khóa
                                                            </a>
                                                        }
                                                        else
                                                        {
                                                            <a href="/CategoryManage/ToggleActive/@item.ID" class="btn btn-success btn-sm">
                                                                <i class="fas fa-unlock mr-1"></i>Mở khóa
                                                            </a>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="4" class="text-center py-4">
                                                <div class="alert alert-info mb-0">
                                                    <i class="fas fa-info-circle mr-2"></i>Không tìm thấy danh mục nào
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="mt-3">
                            <nav aria-label="Page navigation">
                                <ul class="pagination justify-content-center">
                                </ul>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    $(document).ready(function () {

        $('tbody tr').hover(
            function () { $(this).addClass('bg-light'); },
            function () { $(this).removeClass('bg-light'); }
        );

        $('.btn').click(function () {
            $(this).addClass('active');
        });
    });
</script>