@model List<CosmeticsShop.Models.Message>
@{
    ViewBag.Title = "Chat với KH";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    table.table {
        border-collapse: collapse;
    }

        table.table thead {
            background-color: #f8f9fa;
        }

        table.table th,
        table.table td {
            vertical-align: middle;
        }

    table.table-hover tbody tr:hover {
        background-color: #f2f2f2;
    }

    .btn-sm i {
        margin-right: 4px;
    }

    .table td .btn {
        margin-right: 5px;
    }

    .card-title i {
        color: #007bff;
    }

    .badge {
        font-size: 90%;
    }

    .btn-primary i {
        margin-right: 3px;
    }

    .text-nowrap {
        white-space: nowrap;
    }

    .customer-name {
        font-weight: bold;
        color: #6c757d;
    }

    .message-content {
        max-width: 300px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .time-badge {
        font-size: 85%;
    }

    .time-recent {
        background-color: #28a745;
    }

    .time-old {
        background-color: #6c757d;
    }
</style>

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-3">
            <div class="col-sm-6">
                <h1 class="m-0 text-primary">
                    <i class="fas fa-comments mr-2"></i>Chat với khách hàng
                </h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/Admin">Trang chủ</a></li>
                    <li class="breadcrumb-item active">Chat</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card card-primary card-outline shadow-sm">
                    <div class="card-header">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h3 class="card-title font-weight-bold">
                                    <i class="fas fa-list mr-1"></i>Danh sách tin nhắn từ khách hàng
                                </h3>
                            </div>
                            <div class="card-tools">
                                <div class="input-group input-group-sm" style="width: 250px;">
                                    <input type="text" id="searchInput" class="form-control" placeholder="Tìm kiếm khách hàng...">
                                    <div class="input-group-append">
                                        <button type="button" class="btn btn-primary">
                                            <i class="fas fa-search"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card-body">                 
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover" id="chatTable">
                                <thead class="thead-light">
                                    <tr>
                                        <th width="60" class="text-center">ID</th>
                                        <th>Tên khách hàng</th>
                                        <th>Email</th>
                                        <th>Tin nhắn</th>
                                        <th width="150" class="text-center">Thời gian</th>
                                        <th width="180" class="text-center">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model != null && Model.Count > 0)
                                    {
                                        foreach (var item in Model.OrderByDescending(m => m.CreatedDate))
                                        {
                                            <tr>
                                                <td class="text-center">@item.ID</td>
                                                <td class="customer-name">@Html.DisplayFor(modelItem => item.User.Name)</td>
                                                <td>
                                                    <a href="mailto:@item.User.Email" class="text-primary">@item.User.Email</a>
                                                </td>
                                                <td>
                                                    <div class="message-content" title="@Html.DisplayFor(modelItem => item.Content)">
                                                        @Html.DisplayFor(modelItem => item.Content)
                                                    </div>
                                                </td>
                                                <td class="text-center">
                                                    @if (item.CreatedDate.HasValue)
                                                    {
                                                        var timeDiff = DateTime.Now - item.CreatedDate.Value;
                                                        if (timeDiff.TotalMinutes < 1)
                                                        {
                                                            <span class="badge bg-white text-dark border px-2 py-1">
                                                                <i class="fas fa-clock me-1"></i>Vừa xong
                                                            </span>
                                                        }
                                                        else if (timeDiff.TotalHours < 1)
                                                        {
                                                            <span class="badge bg-white text-dark border px-2 py-1">
                                                                <i class="fas fa-clock me-1"></i>@(timeDiff.Minutes) phút trước
                                                            </span>
                                                        }
                                                        else if (timeDiff.TotalDays < 1)
                                                        {
                                                            <span class="badge bg-white text-dark border px-2 py-1">
                                                                <i class="fas fa-clock me-1"></i>@(timeDiff.Hours) giờ trước
                                                            </span>
                                                        }
                                                        else if (timeDiff.TotalDays < 7)
                                                        {
                                                            <span class="badge bg-white text-dark border px-2 py-1">
                                                                <i class="fas fa-calendar me-1"></i>@(timeDiff.Days) ngày trước
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-white text-dark border px-2 py-1">
                                                                <i class="fas fa-calendar me-1"></i>@item.CreatedDate.Value.ToString("dd/MM/yyyy")
                                                            </span>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-white text-dark border px-2 py-1">
                                                            <i class="fas fa-question me-1"></i>Không xác định
                                                        </span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    <a href="@Url.Action("Chating", "Chat", new { WithUserID = item.FromUserID, MessageID = item.ID })" class="btn btn-primary btn-sm">
                                                        <i class="fas fa-eye mr-1"></i>Xem chat
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center py-4">
                                                <div class="alert alert-info mb-0">
                                                    <i class="fas fa-info-circle mr-2"></i>Chưa có tin nhắn nào từ khách hàng
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="mt-3">
                            <nav aria-label="Page navigation">
                                <ul class="pagination justify-content-center">
                                    <!-- Phân trang có thể được thêm vào đây nếu cần -->
                                </ul>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    $(document).ready(function () {
        $('tbody tr').hover(
            function () { $(this).addClass('bg-light'); },
            function () { $(this).removeClass('bg-light'); }
        );

        $('.btn').click(function () {
            $(this).addClass('active');
        });

        // Tìm kiếm khách hàng
        $('#searchInput').on('keyup', function () {
            var value = $(this).val().toLowerCase();
            $('#chatTable tbody tr').filter(function () {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
            });
        });
    });
</script>