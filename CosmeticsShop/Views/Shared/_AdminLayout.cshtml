<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
    <link rel="stylesheet" href="~/Content/Admin/plugins/fontawesome-free/css/all.min.css">
    <link rel="stylesheet" href="https://code.ionicframework.com/ionicons/2.0.1/css/ionicons.min.css">
    <link rel="stylesheet" href="~/Content/Admin/plugins/tempusdominus-bootstrap-4/css/tempusdominus-bootstrap-4.min.css">
    <link rel="stylesheet" href="~/Content/Admin/plugins/icheck-bootstrap/icheck-bootstrap.min.css">
    <link rel="stylesheet" href="~/Content/Admin/plugins/jqvmap/jqvmap.min.css">
    <link rel="stylesheet" href="~/Content/Admin/css/adminlte.min.css">
    <link rel="stylesheet" href="~/Content/Admin/plugins/overlayScrollbars/css/OverlayScrollbars.min.css">
    <link rel="stylesheet" href="~/Content/Admin/plugins/daterangepicker/daterangepicker.css">
    <link rel="stylesheet" href="~/Content/Admin/plugins/summernote/summernote-bs4.min.css">
    <script src="~/Content/Admin/plugins/jquery/jquery.min.js"></script>
    <script src="~/Content/Admin/plugins/jquery-ui/jquery-ui.min.js"></script>
    <script src="~/Content/js/notify.min.js"></script>
</head>
<style>
    .main-sidebar {
        background: linear-gradient(180deg, #343a40 0%, #212529 100%);
    }

    .brand-link {
        background: rgba(255, 255, 255, 0.1);
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .brand-link:hover {
        background: rgba(255, 255, 255, 0.15);
    }

    .user-panel {
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .user-panel .info a {
        color: #fff;
        font-weight: 500;
    }

    .nav-header {
        background: rgba(255, 255, 255, 0.05);
        color: #adb5bd;
        font-weight: 600;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 8px 15px;
        margin: 10px 0 5px 0;
        border-radius: 4px;
    }

    .nav-sidebar .nav-item > .nav-link {
        border-radius: 4px;
        margin: 2px 8px;
        transition: all 0.3s ease;
    }

    .nav-sidebar .nav-item > .nav-link:hover {
        background: rgba(255, 255, 255, 0.1);
        transform: translateX(5px);
    }

    .nav-sidebar .nav-item > .nav-link.active {
        background: rgba(0, 123, 255, 0.2);
        border-left: 3px solid #007bff;
    }

    .nav-treeview .nav-link {
        padding-left: 50px;
        font-size: 0.9rem;
    }

    .nav-treeview .nav-link:hover {
        background: rgba(255, 255, 255, 0.05);
        border-radius: 4px;
    }

    .nav-sidebar .nav-icon {
        width: 20px;
        text-align: center;
        margin-right: 10px;
    }

    .sidebar-search-form {
        margin: 10px 15px;
    }

    .form-control-sidebar {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: #fff;
    }

    .form-control-sidebar:focus {
        background: rgba(255, 255, 255, 0.15);
        border-color: #007bff;
        color: #fff;
    }

    .form-control-sidebar::placeholder {
        color: rgba(255, 255, 255, 0.6);
    }

    .btn-sidebar {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: #fff;
    }

    .btn-sidebar:hover {
        background: rgba(255, 255, 255, 0.2);
        color: #fff;
    }

    .badge {
        font-size: 0.7rem;
        padding: 3px 6px;
    }
    .sidebar::-webkit-scrollbar {
        width: 6px;
    }

    .sidebar::-webkit-scrollbar-track {
        background: rgba(255, 255, 255, 0.1);
    }

    .sidebar::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.3);
        border-radius: 3px;
    }

    .sidebar::-webkit-scrollbar-thumb:hover {
        background: rgba(255, 255, 255, 0.5);
    }
</style>
<body class="hold-transition sidebar-mini layout-fixed">
    <div class="wrapper">
        <div class="preloader flex-column justify-content-center align-items-center">
            <img class="animation__shake" src="~/Content/images/logo.jpg" alt="AdminLTELogo" height="60" width="60">
        </div>
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
                </li>
            </ul>
            <ul class="navbar-nav ml-auto">
                <li class="nav-item dropdown">
                    <a class="nav-link" data-toggle="dropdown" href="#">
                        <i class="far fa-comments"></i>
                        <span class="badge badge-danger navbar-badge" id="messTotalNoti">3</span>
                    </a>
                    <div class="dropdown-menu dropdown-menu-lg dropdown-menu-right" id="messageNoti">
                        <a href="#" class="dropdown-item">
                            <div class="media">
                                <img src="~/Content/Admin/img/user1-128x128.jpg" alt="User Avatar" class="img-size-50 mr-3 img-circle">
                                <div class="media-body">
                                    <h3 class="dropdown-item-title">
                                        Brad Diesel
                                        <span class="float-right text-sm text-danger"><i class="fas fa-star"></i></span>
                                    </h3>
                                    <p class="text-sm">Call me whenever you can...</p>
                                    <p class="text-sm text-muted"><i class="far fa-clock mr-1"></i> 4 Hours Ago</p>
                                </div>
                            </div>
                        </a>
                        <div class="dropdown-divider"></div>
                        <a href="#" class="dropdown-item dropdown-footer">See All Messages</a>
                    </div>
                </li>
            </ul>
        </nav>
        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <div class="sidebar">
                <div class="user-panel mt-3 pb-3 mb-3 d-flex">
                    @{
                        CosmeticsShop.Models.User user = Session["User"] as CosmeticsShop.Models.User;
                        if (user != null)
                        {
                            <div class="image">
                                <img src="~/Content/images/Avatar/admin.jpg" class="img-circle" alt="User Avatar">
                            </div>
                            <div class="info">
                                <a href="#" class="d-block">@user.Name</a>
                                <span class="badge badge-success">Admin</span>
                            </div>
                        }
                        else
                        {
                            <div class="info" style="text-align:center; width: 100%;">
                                <a href="#" class="d-block">Hệ quản trị ADMIN</a>
                            </div>
                        }
                    }
                </div>

                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">

                        <li class="nav-item">
                            <a href="/Admin/" class="nav-link">
                                <i class="nav-icon fas fa-tachometer-alt text-info"></i>
                                <p>
                                    Tổng quan
                                </p>
                            </a>
                        </li>

                        <li class="nav-header">QUẢN LÝ HỆ THỐNG</li>
                        <li class="nav-item">
                            <a href="#" class="nav-link">
                                <i class="nav-icon fas fa-cogs text-warning"></i>
                                <p>
                                    Quản lý sản phẩm
                                    <i class="fas fa-angle-left right"></i>
                                </p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a href="/ProductManage/Index" class="nav-link">
                                        <i class="fas fa-box nav-icon text-primary"></i>
                                        <p>Sản phẩm</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="/CategoryManage/Index" class="nav-link">
                                        <i class="fas fa-tags nav-icon text-success"></i>
                                        <p>Danh mục</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="/OrderManage/" class="nav-link">
                                        <i class="fas fa-shopping-cart nav-icon text-danger"></i>
                                        <p>Đơn đặt hàng</p>
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <li class="nav-header">KHÁCH HÀNG</li>
                        <li class="nav-item">
                            <a href="/KhachHangManage/" class="nav-link">
                                <i class="nav-icon fas fa-users text-primary"></i>
                                <p>
                                    Quản lý khách hàng
                                </p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/Chat/" class="nav-link">
                                <i class="nav-icon fas fa-comments text-success"></i>
                                <p>
                                    Chat với KH
                                </p>
                            </a>
                        </li>
                    
                        <li class="nav-header">KHÁC</li>
                        <li class="nav-item">
                            <a href="/Home/SignOut" class="nav-link" onclick="return confirm('Bạn có chắc chắn muốn đăng xuất?')">
                                <i class="nav-icon fas fa-sign-out-alt text-danger"></i>
                                <p>
                                    Đăng xuất
                                </p>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </aside>
        <div class="content-wrapper">
            @RenderBody()
        </div>
    </div>
    <script>$.widget.bridge('uibutton', $.ui.button)</script>
    <script src="~/Content/Admin/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/Content/Admin/plugins/chart.js/Chart.min.js"></script>
    <script src="~/Content/Admin/plugins/sparklines/sparkline.js"></script>
    <script src="~/Content/Admin/plugins/jqvmap/jquery.vmap.min.js"></script>
    <script src="~/Content/Admin/plugins/jqvmap/maps/jquery.vmap.usa.js"></script>
    <script src="~/Content/Admin/plugins/jquery-knob/jquery.knob.min.js"></script>
    <script src="~/Content/Admin/plugins/moment/moment.min.js"></script>
    <script src="~/Content/Admin/plugins/daterangepicker/daterangepicker.js"></script>
    <script src="~/Content/Admin/plugins/tempusdominus-bootstrap-4/js/tempusdominus-bootstrap-4.min.js"></script>
    <script src="~/Content/Admin/plugins/summernote/summernote-bs4.min.js"></script>
    <script src="~/Content/Admin/plugins/overlayScrollbars/js/jquery.overlayScrollbars.min.js"></script>    
    <script src="~/Content/Admin/js/adminlte.js"></script>
    <script src="~/Content/Admin/js/demo.js"></script>
    <script src="~/Content/Admin/js/pages/dashboard.js"></script>

    <script src="~/Scripts/jquery.signalR-2.4.2.min.js"></script>
    <script src="~/signalr/hubs" type="text/javascript"></script>
    <script>
        $(function () {
            var chat = $.connection.chatHubs
            chat.client.displayMessage = function () {
                getMessageNotiData();
            }
            $.connection.hub.start();
            getMessageNotiData();
        })
        function getMessageNotiData() {
            var $noti = $('#messageNoti')
            var $totalNofi = $('#messTotalNoti')
            $.ajax({
                url: location.origin + "/Chat/GetNotiMessage",
                type: 'GET',
                dataType: 'JSON',
                success: function (data) {
                    $noti.empty()
                    $totalNofi.empty()
                    if (data.length > 0) {
                        $totalNofi.append(
                            data.length
                        )
                        $.each(data, function (i, model) {
                            $noti.append(
                                '<a href = "/Chat/Chating?WithUserID=' + model.FromUserID + '&MessageID=' + model.ID + '" class= "dropdown-item" id="' + model.FromUserID + '">' +
                                '<div class="media">' +
                                '<img src="/Content/images/Avatar/client.jpg' + '" alt="User Avatar" class="img-size-50 mr-3 img-circle">' +
                                '<div class="media-body">' +
                                '<h3 class="dropdown-item-title">'
                                + model.FromUserName +
                                '<span class="float-right text-sm text-danger"><i class="fas fa-star"></i></span>' +
                                '</h3>' +
                                '<p class="text-sm text-muted"><i class="far fa-clock mr-1"></i>' + model.CreatedDate + ' phút trước</p>' +
                                '</div>' +
                                '</div>' +
                                '</a>'
                            );
                        })
                    } else {
                        $totalNofi.append(
                            0
                        )
                        $noti.append(
                            '<a href="/Chat/" class="dropdown-item dropdown-footer">Xem tất cả tin nhắn</a>'
                        );
                    }
                }
            })
        }
        $('#btn-chat').click(function send() {
            var fromId = $('#user-id').val();
            var content = $('#btn-input').val();
            $.ajax({
                url: location.origin + "/Chat/Send",
                data: { FromUserID: fromId, ToUserID: 1, Content: content, Side: "Admin" },
                type: 'POST',
                dataType: 'JSON',
                success: function (data) {
                    if (data.status) {
                        getLastData();
                        $('#btn-input').val("");
                        $(".chatbox__body").animate({ scrollTop: 2000000 });
                    } else {
                        alert("Có lỗi xảy ra");
                        return;
                    }
                }
            })
        })
    </script>
</body>
</html>
