@model CosmeticsShop.Models.Product
@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/_ProductLayout.cshtml";

    List<CosmeticsShop.Models.Category> categories = ViewBag.ListCategory as List<CosmeticsShop.Models.Category>;
}
<script>
    $(document).ready(function () {
        $('.item_add').click(function () {
            event.preventDefault();
            var ID = $(this).data("id");
            $.ajax({
                url: '/Cart/AddItem',
                data: {
                    ProductID: ID
                },
                type: 'POST',
                dataType: 'json',
                success: function (response) {
                    if (response.status == true) {
                        $.notify("Thêm vào giỏ hàng thành công!", "success");

                        $.ajax({
                            url: '/Cart/GetTotalCart',
                            type: 'GET',
                            dataType: 'json',
                            success: function (response) {
                                $(".simpleCart_total").html(response.TotalPrice + "₫ (" + response.TotalQuantity + ")")
                            },
                        });
                    } else {
                        $.notify("Số lượng không đủ!", "error");
                    }
                },
            });
        });
        var fullDescription = $('.full-description').html();
        var shortDescription = truncateDescription(fullDescription, 4);

        if (isDescriptionLong(fullDescription)) {
            $('.short-description').html(shortDescription);
            $('.description-container .see-more').show();
        } else {
            $('.short-description').html(fullDescription);
            $('.description-container .see-more').hide();
        }

        $('.see-more').click(function (e) {
            e.preventDefault();
            if ($(this).hasClass('expanded')) {
                $('.short-description').html(shortDescription);
                $(this).text('Xem thêm');
                $(this).removeClass('expanded');
            } else {
                $('.short-description').html(fullDescription);
                $(this).text('Thu gọn');
                $(this).addClass('expanded');
            }
        });
        function isDescriptionLong(text) {
            var lines = text.split('<br>');
            return lines.length > 4;
        }

        function truncateDescription(text, lines) {
            var splitText = text.split('<br>');
            if (splitText.length <= lines) {
                return text;
            }

            var truncated = splitText.slice(0, lines).join('<br>');
            return truncated;
        }
    });
</script>
<div class="breadcrumbs">
    <div class="container">
        <ol class="breadcrumb breadcrumb1 animated wow slideInLeft animated" data-wow-delay=".5s" style="visibility: visible; animation-delay: 0.5s; animation-name: slideInLeft;">
            <li><a style="color:black" href="/"><span style="color:black" class="glyphicon glyphicon-home" aria-hidden="true"></span>Trang chủ</a></li>
            <li><a style="color:black" href="/">Sản phẩm</a></li>
            <li class="active">@Model.Name</li>
        </ol>
    </div>
</div>
<div class="single">
    <div class="container">
        <div class="col-md-9">
            <div class="col-md-5 grid">
                <div class="flexslider">
                    <ul class="slides">
                        <li data-thumb="@Url.Content("~/Content/images/SanPham/" + Model.Image1)">
                            <div class="thumb-image"> <img src="@Url.Content("~/Content/images/SanPham/" + Model.Image1)" data-imagezoom="true" class="img-responsive"> </div>
                        </li>
                        @if (Model.Image2 != null)
                        {
                            <li data-thumb="@Url.Content("~/Content/images/SanPham/" + Model.Image2)">
                                <div class="thumb-image"> <img src="@Url.Content("~/Content/images/SanPham/" + Model.Image2)" data-imagezoom="true" class="img-responsive"> </div>
                            </li>
                        }
                        @if (Model.Image3 != null)
                        {
                            <li data-thumb="@Url.Content("~/Content/images/SanPham/" + Model.Image3)">
                                <div class="thumb-image"> <img src="@Url.Content("~/Content/images/SanPham/" + Model.Image3)" data-imagezoom="true" class="img-responsive"> </div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
            <div class="col-md-7 single-top-in">
                <div class="single-para simpleCart_shelfItem">
                    <h2 style="color:black">@Model.Name</h2>
                    <div class="star-on">
                        <ul>
                            <li><a href="#"><i class="glyphicon glyphicon-star"> </i></a></li>
                            <li><a href="#"><i class="glyphicon glyphicon-star"> </i></a></li>
                            <li><a href="#"><i class="glyphicon glyphicon-star"> </i></a></li>
                            <li><a href="#"><i class="glyphicon glyphicon-star"> </i></a></li>
                            <li><a href="#"><i class="glyphicon glyphicon-star"> </i></a></li>
                        </ul>
                        <div class="review">
                            <a href="#"> 3 reviews </a>/
                            <a href="#">  Write a review</a>
                        </div>

                        <div class="clearfix"> </div>
                    </div>
                    <p class="item_price">Đã bán: @Model.PurchasedCount</p>
                    <hr />
                    <label style="color:black" class="add-to item_price">@Model.Price.Value.ToString("#,##")₫</label>
                    <hr />

                    <div class="description-container">
                        <div class="full-description" style="display: none;">@Html.Raw(Model.Description.Replace("\n", "<br>"))</div>
                        <p class="short-description description"></p>
                        <a href="#" class="see-more" style="color: blue; text-decoration: underline; display: none;">Xem thêm</a>
                    </div>

                    <a style="background-color:orangered" href="#" class="cart item_add" data-id="@Model.ID">Thêm vào giỏ hàng</a>
                </div>
            </div>
            <div class="clearfix"> </div>
        </div>
    </div>
</div>