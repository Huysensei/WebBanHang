@{
    ViewBag.Title = "Trang chủ";
    Layout = "~/Views/Shared/_HomeLayout.cshtml";

    List<CosmeticsShop.Models.Product> products = ViewBag.ListProduct as List<CosmeticsShop.Models.Product>;
}

<style>
    .lien-he-container {
        width: 90%;
        max-width: 1200px;
        margin: 0 auto;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: #333;
    }

        .lien-he-container .header {
            background: linear-gradient(135deg, #8B4513, #A0522D);
            color: white;
            padding: 60px 30px;
            border-radius: 16px;
            text-align: center;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        }

        .lien-he-container .btn {
            display: inline-block;
            padding: 12px 28px;
            background: #D2691E;
            color: white;
            text-decoration: none;
            border-radius: 30px;
            font-weight: bold;
            margin-top: 20px;
            transition: background 0.3s ease;
        }

            .lien-he-container .btn:hover {
                background: #a7490e;
            }

    section {
        padding: 50px 0;
        text-align: center;
    }

        section h2 {
            font-size: 28px;
            color: #8B4513;
            margin-bottom: 15px;
        }

    .loi-ich-grid,
    .bao-chi-grid {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 25px;
        margin-top: 20px;
    }

    .loi-ich-item,
    .bao-chi-item {
        background: #fff8f0;
        padding: 20px;
        border-radius: 12px;
        width: 220px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.08);
        transition: transform 0.3s;
    }

        .loi-ich-item:hover,
        .bao-chi-item:hover {
            transform: translateY(-5px);
        }

    .thong-ke {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        background: #f1f1f1;
        border-radius: 12px;
        padding: 30px;
        margin: 0 auto;
        gap: 20px;
    }

    .stat {
        flex: 1 1 200px;
        background: #fff;
        padding: 20px;
        border-radius: 10px;
        font-size: 22px;
        font-weight: bold;
        color: #A0522D;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
        text-align: center;
    }

    .khach-hang p,
    .lien-he p {
        font-size: 18px;
        margin-top: 10px;
    }
</style>

