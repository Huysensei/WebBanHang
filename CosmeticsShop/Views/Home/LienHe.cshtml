@{
    ViewBag.Title = "Trang chủ";
    Layout = "~/Views/Shared/_HomeLayout.cshtml";

    List<CosmeticsShop.Models.Product> products = ViewBag.ListProduct as List<CosmeticsShop.Models.Product>;
}

<style>
    :root {
        --primary-color: #8B4513;
        --secondary-color: #D2691E;
        --accent-color: #A0522D;
        --bg-light: #FFF8F0;
        --text-dark: #333;
        --shadow-sm: 0 4px 8px rgba(0, 0, 0, 0.08);
        --shadow-md: 0 4px 15px rgba(0, 0, 0, 0.15);
        --radius-sm: 8px;
        --radius-md: 12px;
        --radius-lg: 16px;
        --transition: all 0.3s ease;
    }

    .lien-he-container {
        width: 90%;
        max-width: 1200px;
        margin: 0 auto;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: var(--text-dark);
        padding-bottom: 60px;
    }
/*    .btn {
        display: inline-block;
        padding: 14px 32px;
        background: var(--secondary-color);
        color: white;
        text-decoration: none;
        border-radius: 50px;
        font-weight: 600;
        font-size: 1rem;
        letter-spacing: 0.5px;
        transition: var(--transition);
        border: none;
        cursor: pointer;
    }*/

    .btn:hover {
        background: #a7490e;
        transform: translateY(-3px);
        box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
    }

    section {
        padding: 50px 0;
        text-align: center;
    }

    section h2 {
        font-size: 2rem;
        color: var(--primary-color);
        margin-bottom: 20px;
        position: relative;
        display: inline-block;
        padding-bottom: 10px;
    }

    section h2::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 80px;
        height: 3px;
        background: var(--secondary-color);
    }

    section p {
        font-size: 1.1rem;
        line-height: 1.7;
        max-width: 800px;
        margin: 0 auto 20px;
    }

    .chuong-trinh-img {
        max-width: 100%;
        height: auto;
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-sm);
    }

    .loi-ich-grid,
    .bao-chi-grid {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 25px;
        margin-top: 30px;
    }

    .loi-ich-item {
        background: var(--bg-light);
        padding: 30px 20px;
        border-radius: var(--radius-md);
        width: 250px;
        box-shadow: var(--shadow-sm);
        transition: var(--transition);
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .loi-ich-item:hover {
        transform: translateY(-8px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
    }

    .loi-ich-icon {
        font-size: 2.5rem;
        color: var(--secondary-color);
        margin-bottom: 15px;
    }

    .loi-ich-title {
        font-weight: 600;
        margin-bottom: 10px;
        font-size: 1.1rem;
    }

    .loi-ich-desc {
        font-size: 0.95rem;
        color: #555;
    }

    .thong-ke-section {
        background: linear-gradient(135deg, #f5f5f5, #e9e9e9);
        padding: 60px 0;
        margin: 40px 0;
        border-radius: var(--radius-lg);
    }

    .thong-ke {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 20px;
        max-width: 1000px;
        margin: 0 auto;
    }

    .stat {
        flex: 1 1 200px;
        background: white;
        padding: 25px 20px;
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-sm);
        text-align: center;
        transition: var(--transition);
    }

    .stat:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 15px rgba(0, 0, 0, 0.1);
    }

    .stat-number {
        font-size: 2.2rem;
        font-weight: 700;
        color: var(--accent-color);
        margin-bottom: 5px;
    }

    .stat-text {
        font-size: 1rem;
        color: #555;
    }


    .lien-he-form-container {
        max-width: 800px;
        margin: 0 auto;
        background: var(--bg-light);
        padding: 40px;
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-md);
    }

    .lien-he-info {
        display: flex;
        flex-wrap: wrap;
        gap: 30px;
        margin-bottom: 40px;
    }

    .lien-he-item {
        flex: 1 1 220px;
        display: flex;
        align-items: center;
    }

    .lien-he-icon {
        font-size: 1.8rem;
        color: var(--secondary-color);
        margin-right: 15px;
    }

    .lien-he-text {
        text-align: left;
    }

    .lien-he-text strong {
        display: block;
        margin-bottom: 5px;
    }

    .form-group {
        margin-bottom: 20px;
        text-align: left;
    }

    .form-label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
        color: var(--text-dark);
    }

    .form-control {
        width: 100%;
        padding: 12px 15px;
        border: 1px solid #ddd;
        border-radius: var(--radius-sm);
        font-family: inherit;
        font-size: 1rem;
        transition: var(--transition);
    }

    .form-control:focus {
        border-color: var(--secondary-color);
        outline: none;
        box-shadow: 0 0 0 3px rgba(210, 105, 30, 0.2);
    }

    textarea.form-control {
        min-height: 120px;
        resize: vertical;
    }

    .form-row {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
    }

    .form-col {
        flex: 1 1 300px;
    }

   
    }
</style>

<div class="lien-he-container">

    <section class="chuong-trinh">
        <h2>CHƯƠNG TRÌNH ĐỐI TÁC CHIẾN LƯỢC</h2>
        <img src="~/Content/images/LienHe/Lienhe1.jpg.png" alt="Chương trình đối tác HOMAROOM" class="chuong-trinh-img" />
        <p>HOMAROOM đang tìm kiếm các đối tác cung cấp sản phẩm và dịch vụ chất lượng cao nhằm mở rộng hệ thống và mang lại giá trị tốt nhất cho khách hàng.</p>
        <p>Với vị thế là một trong những thương hiệu nội thất hàng đầu Việt Nam, HOMAROOM mong muốn liên kết với các đối tác trong lĩnh vực sản xuất và phân phối các sản phẩm như: <strong>Vật phẩm trang trí, đồ dùng nhà bếp, nệm và các sản phẩm liên quan</strong>, nhằm cùng nhau chinh phục ngành hàng Nhà cửa - Đời sống và đáp ứng nhu cầu ngày càng cao của khách hàng.</p>
    </section>

    <section class="loi-ich">
        <h2>LỢI ÍCH KHI HỢP TÁC CÙNG HOMAROOM</h2>
        <div class="loi-ich-grid">
            <div class="loi-ich-item">
                <div class="loi-ich-icon">👥</div>
                <div class="loi-ich-title">Tiếp cận hệ thống khách hàng lớn</div>
                <div class="loi-ich-desc">Kết nối với hàng triệu khách hàng tiềm năng trong hệ sinh thái HOMAROOM</div>
            </div>
            <div class="loi-ich-item">
                <div class="loi-ich-icon">📈</div>
                <div class="loi-ich-title">Chiến lược marketing toàn diện</div>
                <div class="loi-ich-desc">Được hỗ trợ tiếp thị đa kênh và quảng bá thương hiệu chuyên nghiệp</div>
            </div>
            <div class="loi-ich-item">
                <div class="loi-ich-icon">🌐</div>
                <div class="loi-ich-title">Mở rộng thị trường</div>
                <div class="loi-ich-desc">Cơ hội tiếp cận 25+ showroom trên toàn quốc và nền tảng online</div>
            </div>
            <div class="loi-ich-item">
                <div class="loi-ich-icon">🤝</div>
                <div class="loi-ich-title">Phát triển bền vững</div>
                <div class="loi-ich-desc">Đồng hành dài hạn cùng đối tác uy tín hàng đầu trong ngành</div>
            </div>
        </div>
    </section>

    <section class="thong-ke-section">
        <h2>HOMAROOM TRONG CON SỐ</h2>
        <div class="thong-ke">
            <div class="stat">
                <div class="stat-number">40M+</div>
                <div class="stat-text">Doanh thu hàng năm (tỷ VNĐ)</div>
            </div>
            <div class="stat">
                <div class="stat-number">500+</div>
                <div class="stat-text">Đối tác tin cậy</div>
            </div>
            <div class="stat">
                <div class="stat-number">4000+</div>
                <div class="stat-text">Sản phẩm đa dạng</div>
            </div>
            <div class="stat">
                <div class="stat-number">25+</div>
                <div class="stat-text">Showroom toàn quốc</div>
            </div>
        </div>
    </section>

   
    <section class="lien-he" id="hop-tac">
        <h2>LIÊN HỆ HỢP TÁC</h2>
        <div class="lien-he-form-container">
            <div class="lien-he-info">
                <div class="lien-he-item">
                    <div class="lien-he-icon">📍</div>
                    <div class="lien-he-text">
                        <strong>Trụ sở chính</strong>
                        Kim Liên, Nam Đàn, Nghệ An
                    </div>
                </div>
                <div class="lien-he-item">
                    <div class="lien-he-icon">📞</div>
                    <div class="lien-he-text">
                        <strong>Hotline</strong>
                        (+84) 969 064733
                    </div>
                </div>
                <div class="lien-he-item">
                    <div class="lien-he-icon">✉️</div>
                    <div class="lien-he-text">
                        <strong>Email</strong>
                        pnh5523@homaroom.com
                    </div>
                </div>
            </div>

            <form action="#" method="post" id="contact-form">
                <div class="form-row">
                    <div class="form-col">
                        <div class="form-group">
                            <label for="name" class="form-label">Họ và tên</label>
                            <input type="text" id="name" name="name" class="form-control" required>
                        </div>
                    </div>
                    <div class="form-col">
                        <div class="form-group">
                            <label for="company" class="form-label">Tên công ty</label>
                            <input type="text" id="company" name="company" class="form-control" required>
                        </div>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-col">
                        <div class="form-group">
                            <label for="email" class="form-label">Email</label>
                            <input type="email" id="email" name="email" class="form-control" required>
                        </div>
                    </div>
                    <div class="form-col">
                        <div class="form-group">
                            <label for="phone" class="form-label">Số điện thoại</label>
                            <input type="tel" id="phone" name="phone" class="form-control" required>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label for="product_type" class="form-label">Loại sản phẩm/dịch vụ của bạn</label>
                    <input type="text" id="product_type" name="product_type" class="form-control" required>
                </div>

                <div class="form-group">
                    <label for="message" class="form-label">Thông tin chi tiết</label>
                    <textarea id="message" name="message" class="form-control" required></textarea>
                </div>

                <button type="submit" class="btn">GỬI THÔNG TIN</button>
            </form>
        </div>
    </section>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const form = document.getElementById('contact-form');

        form.addEventListener('submit', function (e) {
            e.preventDefault();
            alert('Cảm ơn bạn đã gửi thông tin! Chúng tôi sẽ liên hệ lại trong thời gian sớm nhất.');
            form.reset();
        });
    });
</script>